{
  "name": "gba-emulator-web",
  "version": "1.0.0",
  "description": "GBA web emulator for Playwright testing - Pokemon Unbound translation verification",
  "type": "module",
  "scripts": {
    "build": "node build-browser.mjs && tsc",
    "build:browser": "node build-browser.mjs",
    "start": "node dist/server.js",
    "predev": "node build-browser.mjs",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.0",
    "gbajs": "^1.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
