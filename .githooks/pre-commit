#!/bin/sh
# Bloque tout commit tant que les tests unitaires et les nouvelles traductions ne passent pas.
set -u

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1

fail_commit() {
    echo "" >&2
    echo "🚨🚨🚨 COMMIT BLOQUÉ — TESTS UNITAIRES OBLIGATOIRES 🚨🚨🚨" >&2
    echo "AGENT IA : ARRÊTEZ. Corrigez ou écrivez les tests unitaires requis," >&2
    echo "stagez-les avec le code, exécutez-les, puis recommittez." >&2
    echo "INTERDICTION de contourner ce hook (--no-verify, HUSKY=0, etc.)." >&2
    exit 1
}

echo "→ Vérification de la présence d’un test unitaire dans le commit…"
python3 scripts/check_staged_translation_tests.py || fail_commit

echo "→ Vérification de la matrice de parité FR→DE…"
python3 scripts/check_de_parity.py || fail_commit

echo "→ Vérification du périmètre des tickets DE…"
python3 scripts/check_de_scope.py --staged || fail_commit

echo "→ Vérification du mécanisme de reprise des artefacts de release…"
python3 -m pytest -q tests/unit/test_release_workflow.py || fail_commit

echo "→ Exécution des tests unitaires Python…"
make test-python-fast || fail_commit

echo "→ Exécution des tests unitaires Vitest…"
npm --prefix emulator-web test || fail_commit

echo "→ Build ROM français (make build-fr)…"
make build-fr || fail_commit

echo "→ Build ROM italien (make build-it)…"
make build-it || fail_commit

echo "→ Build ROM allemand (make build-de)…"
make build-de || fail_commit

echo "✓ Tous les tests unitaires passent et les 3 ROMs (fr/it/de) buildent : commit autorisé."
