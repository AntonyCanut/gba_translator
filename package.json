{
  "name": "gba-translator-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright E2E tests for GBA Translator ROM verification",
  "scripts": {
    "test:e2e": "python3 scripts/materialize_test_roms.py fr && playwright test",
    "test:e2e:boot": "python3 scripts/materialize_test_roms.py fr && playwright test --project=boot",
    "test:e2e:gameplay": "python3 scripts/materialize_test_roms.py fr && playwright test --project=gameplay",
    "test:e2e:translation": "python3 scripts/materialize_test_roms.py fr && playwright test --project=translation",
    "test:e2e:german": "python3 scripts/materialize_test_roms.py de && ROM_PATH=$(pwd)/output/roms/GenedRom-de.gba playwright test --project=german",
    "test:e2e:visual": "python3 scripts/materialize_test_roms.py fr && playwright test --project=visual-regression",
    "test:e2e:story-sequences": "python3 scripts/materialize_test_roms.py fr && playwright test -c tests/e2e-playwright/playwright.story-sequences.config.ts",
    "test:e2e:hp-bar": "python3 scripts/materialize_test_roms.py fr it de && playwright test -c tests/e2e-playwright/playwright.hp-bar.config.ts",
    "test:e2e:ui": "python3 scripts/materialize_test_roms.py fr && playwright test --ui",
    "test:e2e:report": "python3 scripts/run_playwright_tests.py",
    "test:e2e:update-snapshots": "python3 scripts/materialize_test_roms.py fr && playwright test --project=visual-regression --update-snapshots",
    "tickets:list": "python3 scripts/list_tickets.py",
    "tickets:resolve": "python3 scripts/resolve_ticket.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "ws": "^8.21.0"
  }
}
